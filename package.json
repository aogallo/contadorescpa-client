{
  "name": "contadorescpa-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apollo/client": "^3.5.7",
    "@popperjs/core": "^2.11.0",
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "formik": "^2.2.9",
    "graphql": "^16.2.0",
    "jwt-decode": "^3.1.2",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-icons": "^4.7.1",
    "react-router-dom": "^6.2.1",
    "react-scripts": "^5.0.0",
    "redux": "^4.1.2",
    "source-map-explorer": "^2.5.2",
    "web-vitals": "^2.1.2"
  },
  "scripts": {
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "start": "standard && react-scripts start",
    "build": "NODE_ENV=production react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "fixlinter": "standard --fix",
    "dev": "PORT=3001 NODE_ENV=development react-scripts start",
    "lint": "eslint ./src/"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "standard": {
    "env": [
      "jest"
    ],
    "globals": [
      "localStorage"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint": "^8.23.0",
    "eslint-config-react-app": "^7.0.1",
    "standard": "^17.0.0"
  },
  "pre-commit": [
    "lint"
  ]
}
